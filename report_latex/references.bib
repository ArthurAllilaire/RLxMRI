@article{RobPio:99,
title = {Basic principles of magnetic resonance imaging},
journal = {Progress in Cardiovascular Diseases},
volume = {42},
number = {2},
pages = {149-156},
year = {1999},
doi = {https://doi.org/10.1016/S0033-0620(99)70014-9},
url = {https://www.sciencedirect.com/science/article/pii/S0033062099700149},
author = {Robert-Jan M. {van Geuns} and Piotr A. Wielopolski and Hein G. {de Bruin} and Benno J. Rensing and Peter M.A. {van Ooijen} and Marc Hulshoff and Matthijs Oudkerk and Pim J. {de Feyter}},
abstract = {Magnetic resonance imaging (MRI) is a noninvasive imaging technique that is becoming more and more important in clinical cardiology. Physicians must understand the basic principles of MRI before reliable use in practice is possible. Therefore, we will give an introduction to basic MRI principles necessary to understand the difficulties of cardiac MRI. First the generation of a signal by the combination of a strong magnetic field, radiofrequency pulses, and temporary changes in the magnetic field is explained. Then, the processes of localization of different points in an image, resolution, and signal-to-noise ratio are highlighted. Finally, the influence of tissue characteristics such as T1 and T2 on the contrast of an image are discussed. Copyright © 1999 by W.B. Saunders Company Progress in Cardiovascular Diseases, Vol. 42, No. 2 (September/October), 1999: pp 149-156}
}
